# =============================================================================
# AVORA Platform Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=AVORA
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- Database (MySQL) ---
MYSQL_ROOT_PASSWORD=avora_root_secret
MYSQL_DATABASE=avora
MYSQL_USER=avora_user
MYSQL_PASSWORD=change_me_secure_password
DB_HOST=mysql
DB_PORT=3306
DATABASE_URL=mysql://avora_user:change_me_secure_password@mysql:3306/avora

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT Authentication ---
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=AVORA

# --- Email (SMTP) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@avora.rw
MAIL_FROM_NAME=AVORA

# --- SMS (Twilio) ---
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+250000000000

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
MTN_MOMO_API_KEY=your_mtn_momo_api_key
MTN_MOMO_API_SECRET=your_mtn_momo_api_secret
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
AIRTEL_MONEY_CLIENT_ID=your_airtel_client_id
AIRTEL_MONEY_CLIENT_SECRET=your_airtel_client_secret

# --- AI Assistant Features (optional) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key

# --- File Upload / Storage ---
UPLOAD_MAX_SIZE=10485760
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=info
